# IO module -- object list + rules (byte-verified recipes; hand-curate).
IO_OBJS = OUT\DOSRW.OBJ OUT\RESOURCE.OBJ OUT\RESFAR.OBJ

OUT\DOSRW.OBJ : SRC\IO\DOSRW.ASM
	$(AS) $(ASFLAGS) SRC\IO\DOSRW.ASM,OUT\DOSRW.OBJ
OUT\RESOURCE.OBJ : SRC\IO\RESOURCE.C
	$(C_3NY) $(INC) -c -zC_TEXT -nOUT SRC\IO\RESOURCE.C
OUT\RESFAR.OBJ : SRC\IO\RESFAR.C
	$(C_3NY) $(INC) -c -zC_TEXT -nOUT SRC\IO\RESFAR.C
