# GAME module -- object list + rules (byte-verified recipes; hand-curate).
GAME_OBJS = OUT\GMAIN.OBJ OUT\MAINDATA.OBJ OUT\GSTATE.OBJ OUT\SAVEGAME.OBJ OUT\TIMERPL.OBJ OUT\ACTORREC.OBJ OUT\ACTSPAWN.OBJ

OUT\GMAIN.OBJ : SRC\GAME\STATE\GMAIN.C
	$(C_3O1Y) $(INC) -c -zCS205a_TEXT -nOUT SRC\GAME\STATE\GMAIN.C
OUT\MAINDATA.OBJ : SRC\GAME\MAINDATA.C
	$(C_3O1Y) $(INC) -c -zCMAINDATA_TEXT -nOUT SRC\GAME\MAINDATA.C
OUT\GSTATE.OBJ : SRC\GAME\STATE\GSTATE.C
	$(C_3O1Y) $(INC) -c -zCS4209_TEXT -nOUT SRC\GAME\STATE\GSTATE.C
OUT\SAVEGAME.OBJ : SRC\GAME\STATE\SAVEGAME.C
	$(C_3O1Y) $(INC) -c -zCS419f_TEXT -nOUT SRC\GAME\STATE\SAVEGAME.C
OUT\TIMERPL.OBJ : SRC\GAME\STATE\TIMERPL.C
	$(C_3O1Y) $(INC) -c -zCS4364_TEXT -nOUT SRC\GAME\STATE\TIMERPL.C
OUT\ACTORREC.OBJ : SRC\GAME\ACTOR\ACTORREC.C
	$(C_3O1Y) $(INC) -c -zCS5c81_TEXT -nOUT SRC\GAME\ACTOR\ACTORREC.C
OUT\ACTSPAWN.OBJ : SRC\GAME\ACTOR\ACTSPAWN.C
	$(C_3O1Y) $(INC) -c -zCS5b64_TEXT -nOUT SRC\GAME\ACTOR\ACTSPAWN.C
