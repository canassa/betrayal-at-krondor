# GAME module -- object list + rules (byte-verified recipes; hand-curate).
GAME_OBJS = OUT\GMAIN.OBJ OUT\MAINDATA.OBJ OUT\GSTATE.OBJ OUT\SAVEGAME.OBJ OUT\TIMERPL.OBJ OUT\ACTORREC.OBJ OUT\ACTSPAWN.OBJ OUT\MAP.OBJ OUT\WORLDCRS.OBJ OUT\WORLDLP.OBJ OUT\WORLDMOV.OBJ OUT\HOTSPOT.OBJ OUT\RGNENC.OBJ OUT\WORLDDOR.OBJ OUT\E_7878.OBJ OUT\ITEMTBL.OBJ

OUT\GMAIN.OBJ : SRC\GAME\GMAIN.C
	$(C_3O1Y) $(INC) -c -zCS205a_TEXT -nOUT SRC\GAME\GMAIN.C
OUT\MAINDATA.OBJ : SRC\GAME\MAINDATA.C
	$(C_3O1Y) $(INC) -c -zCMAINDATA_TEXT -nOUT SRC\GAME\MAINDATA.C
OUT\GSTATE.OBJ : SRC\GAME\STATE\GSTATE.C
	$(C_3O1Y) $(INC) -c -zCS4209_TEXT -nOUT SRC\GAME\STATE\GSTATE.C
OUT\SAVEGAME.OBJ : SRC\GAME\STATE\SAVEGAME.C
	$(C_3O1Y) $(INC) -c -zCS419f_TEXT -nOUT SRC\GAME\STATE\SAVEGAME.C
OUT\TIMERPL.OBJ : SRC\GAME\STATE\TIMERPL.C
	$(C_3O1Y) $(INC) -c -zCS4364_TEXT -nOUT SRC\GAME\STATE\TIMERPL.C
OUT\ACTORREC.OBJ : SRC\GAME\ACTOR\ACTORREC.C
	$(C_3O1Y) $(INC) -c -zCS5c81_TEXT -nOUT SRC\GAME\ACTOR\ACTORREC.C
OUT\ACTSPAWN.OBJ : SRC\GAME\ACTOR\ACTSPAWN.C
	$(C_3O1Y) $(INC) -c -zCS5b64_TEXT -nOUT SRC\GAME\ACTOR\ACTSPAWN.C
OUT\MAP.OBJ : SRC\GAME\WORLD\MAP.C
	$(C_3O1Y) $(INC) -c -zCS6ed5_TEXT -nOUT SRC\GAME\WORLD\MAP.C
OUT\WORLDCRS.OBJ : SRC\GAME\WORLD\WORLDCRS.C
	$(C_3O1Y) $(INC) -c -zCS7c15_TEXT -nOUT SRC\GAME\WORLD\WORLDCRS.C
OUT\WORLDLP.OBJ : SRC\GAME\WORLD\WORLDLP.C
	$(C_3O1Y) $(INC) -c -zCS6d9f_TEXT -nOUT SRC\GAME\WORLD\WORLDLP.C
OUT\WORLDMOV.OBJ : SRC\GAME\WORLD\WORLDMOV.C
	$(C_3O1Y) $(INC) -c -zCS735e_TEXT -nOUT SRC\GAME\WORLD\WORLDMOV.C
OUT\HOTSPOT.OBJ : SRC\GAME\ENC\HOTSPOT.C
	$(C_3O1Y) $(INC) -c -zCS759a_TEXT -nOUT SRC\GAME\ENC\HOTSPOT.C
OUT\RGNENC.OBJ : SRC\GAME\ENC\RGNENC.C
	$(C_3O1Y) $(INC) -c -zCS7735_TEXT -nOUT SRC\GAME\ENC\RGNENC.C
OUT\WORLDDOR.OBJ : SRC\GAME\ENC\WORLDDOR.C
	$(C_3O1Y) $(INC) -c -zCS7be6_TEXT -nOUT SRC\GAME\ENC\WORLDDOR.C
OUT\E_7878.OBJ : SRC\GAME\ENC\E_7878.ASM
	$(AS) $(ASFLAGS) SRC\GAME\ENC\E_7878.ASM,OUT\E_7878.OBJ
OUT\ITEMTBL.OBJ : SRC\GAME\ACTOR\ITEMTBL.C
	$(C_3O1Y) $(INC) -c -zCS5806_TEXT -nOUT SRC\GAME\ACTOR\ITEMTBL.C
